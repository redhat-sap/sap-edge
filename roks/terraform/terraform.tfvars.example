# Example terraform.tfvars for a ROKS (Red Hat OpenShift on IBM Cloud, VPC)
# cluster. Copy to terraform.tfvars (git-ignored) and adjust.
# The IBM Cloud API key is not a variable: export IBMCLOUD_API_KEY instead.

# Must start with "redhat-", at most 30 characters (it is also the Container
# Registry namespace), lowercase letters, digits, hyphens.
# The make targets pass it as -var cluster_name=$(CLUSTER).
cluster_name = "redhat-roks-eic-pr123"

# Adds the tag pr:<N> to every resource.
pr_number = "123"

region         = "eu-de"
resource_group = "redhat-sap-edge-roks-ci"
zones          = ["eu-de-1", "eu-de-2", "eu-de-3"]

# `ibmcloud oc versions` lists the available versions.
openshift_version = "4.21_openshift"

# 16 vCPU / 64 GB, one worker per zone = 3 workers.
worker_flavor    = "bx2.16x64"
workers_per_zone = 1

# Pod network; IBM accepts /13-/23 inside 172.17.0.0/16, 172.21.0.0-172.31.255.255
# (minus the service subnet 172.21.0.0/16), 192.168.0.0-192.168.254.255 or
# 198.18.0.0/15. Add it to the httpbinipfilter iFlow allowlist.
pod_subnet = "172.17.0.0/18"

# Existing directory for the admin kubeconfig download.
kubeconfig_dir = "./.kube"

# Optional managed services (Terraform default false; the ROKS pipeline sets
# both to true), see README.md. Each one adds billable resources; the
# databases take 30-45 minutes to provision.
#   deploy_postgres: IBM Cloud Databases for PostgreSQL 15 (<cluster_name>-postgres)
#   deploy_redis:    IBM Cloud Databases for Redis (<cluster_name>-redis),
#                    admin password generated (output redis_password)
# The Container Registry namespace and its push/pull API key are always
# created (no variable).
deploy_postgres = false
deploy_redis    = false
# postgres_admin_password (required when deploy_postgres = true): set it via
# TF_VAR_postgres_admin_password, not here. 15-72 characters of letters,
# digits, - and _; at least one lower case letter, one upper case letter and
# one digit; must not start with - or _.
