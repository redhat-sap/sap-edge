# Fake oc/kubectl for testing Tekton task scripts

# Log the call if FAKE_OC_LOG is set
if [[ -n "${FAKE_OC_LOG:-}" ]]; then
  echo "$*" >> "${FAKE_OC_LOG}"
fi

# Save stdin if FAKE_OC_STDIN_DIR is set and this is an apply/create -f -
if [[ -n "${FAKE_OC_STDIN_DIR:-}" ]]; then
  if [[ "$*" =~ (apply|create)[[:space:]]+-f[[:space:]]- ]]; then
    mkdir -p "${FAKE_OC_STDIN_DIR}"
    # Find next number
    NUM=1
    while [[ -f "${FAKE_OC_STDIN_DIR}/${NUM}.yaml" ]]; do
      NUM=$((NUM + 1))
    done
    cat > "${FAKE_OC_STDIN_DIR}/${NUM}.yaml"
  fi
fi

# Print stderr first (oc prints warnings and errors before any output) if
# FAKE_OC_STDERR_RULES is set: GLOB<TAB>STDERR, the first matching line wins
if [[ -n "${FAKE_OC_STDERR_RULES:-}" ]] && [[ -f "${FAKE_OC_STDERR_RULES}" ]]; then
  while IFS=$'\t' read -r GLOB STDERR; do
    # shellcheck disable=SC2053
    if [[ "$*" == ${GLOB} ]]; then
      echo -e "${STDERR}" >&2
      break
    fi
  done < "${FAKE_OC_STDERR_RULES}"
fi

# Apply rules if FAKE_OC_RULES is set
if [[ -n "${FAKE_OC_RULES:-}" ]] && [[ -f "${FAKE_OC_RULES}" ]]; then
  while IFS=$'\t' read -r GLOB EXIT_CODE STDOUT; do
    # Use bash pattern matching (not regex)
    # shellcheck disable=SC2053
    if [[ "$*" == ${GLOB} ]]; then
      # Expand \n in STDOUT
      echo -e "${STDOUT}"
      exit "${EXIT_CODE}"
    fi
  done < "${FAKE_OC_RULES}"
fi

# Default: exit 0, no output
exit 0
